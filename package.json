{
  "name": "wickra-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A polyglot strategy playground: run one StrategySpec live, side by side, byte-identical in Python, Rust, JS and Go — entirely in the browser (WASM), no backend.",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "wickra-backtest-wasm": "^0.1.7",
    "wickra-wasm": "^1.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.11.0",
    "prettier": "^3.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
